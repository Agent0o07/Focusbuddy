{
  "manifest_version": 3,
  "name": "Focusbuddy",
  "version": "1.1.0",
  "description": "StudyStream account rotator with advanced stealth & anti-detection",
  "author": "thedarkknight",
  "homepage_url": "https://github.com/Agent0o07/focusbuddy",
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*.studystream.live/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.studystream.live/*"],
      "js": ["fingerprint.js", "behavior.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Focusbuddy",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  }
}
